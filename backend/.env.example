
# Application
APP_NAME=MediZen AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://postgres:root123@localhost:5432/medivoice
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=False

# Redis (for caching - we'll add later)
REDIS_URL=redis://localhost:6379

# AI Services
GROQ_API_KEY=your_groq_api_key_here

# CORS - Add your frontend URLs
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60